{
  "name": "hierarchical-task-management-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && tsx watch src/server.ts",
    "build": "node api.js && tsc",
    "start": "node api.js && node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "flush:notifications": "tsx src/jobs/flushNotifications.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "seedrandom": "^3.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
